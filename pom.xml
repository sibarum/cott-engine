<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>sibarum.cott</groupId>
    <artifactId>cott-engine-parent</artifactId>
    <version>0.1.2</version>
    <packaging>pom</packaging>

    <name>cott-engine-parent</name>
    <description>
        The traction calculator, as modules: cott-engine (the number model and its prompt, pure Java), and what the
        prompt needs from an operating system's console, behind UnicodeConsole (cott-engine-api), with an OS module
        only where there is something to do: on Windows, whose consoles default to code pages without ω.
    </description>

    <modules>
        <module>cott-engine-api</module>
        <module>cott-engine-windows</module>
        <module>cott-engine</module>
    </modules>

    <properties>
        <maven.compiler.release>25</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <junit.version>5.11.4</junit.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>sibarum.cott</groupId>
                <artifactId>cott-engine-api</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>sibarum.cott</groupId>
                <artifactId>cott-engine-windows</artifactId>
                <version>${project.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <build>
        <pluginManagement>
            <plugins>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-compiler-plugin</artifactId>
                    <version>3.13.0</version>
                    <configuration>
                        <release>${maven.compiler.release}</release>
                    </configuration>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-surefire-plugin</artifactId>
                    <version>3.5.2</version>
                </plugin>
            </plugins>
        </pluginManagement>
        <plugins>
            <!-- `mvn compile exec:exec` from here runs the calculator: skipped everywhere but cott-engine. -->
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>exec-maven-plugin</artifactId>
                <version>3.5.0</version>
                <configuration>
                    <skip>true</skip>
                    <executable>java</executable>
                </configuration>
            </plugin>
            <!-- Platform-specific code only in -windows, -linux and -macos modules: vexelray-build's isolate goal fails
                 the build on any outside them (vexelray-build/README.md). -->
            <plugin>
                <groupId>dev.vexelray.build</groupId>
                <artifactId>vexelray-build-maven-plugin</artifactId>
                <version>0.1.2</version>
                <executions>
                    <execution>
                        <id>isolate</id>
                        <goals>
                            <goal>isolate</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
    <profiles>
        <!-- On Linux the build goes to target-linux/, not target/: the Windows host and a Linux VM build the same checkout
             (a shared folder), and each keeps its own output beside the other's instead of overwriting it. -->
        <profile>
            <id>linux-build-output</id>
            <activation>
                <os>
                    <family>unix</family>
                    <name>linux</name>
                </os>
            </activation>
            <build>
                <directory>${project.basedir}/target-linux</directory>
            </build>
        </profile>
    </profiles>
</project>
